<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Endon Music — Listening Extract 1</title><style>body{font-family:Arial,sans-serif;background:#14233d;color:white;max-width:800px;margin:40px auto;padding:18px}h1{font-size:26px}.panel{background:#243957;border-radius:14px;padding:22px}button{background:#5e9aff;color:#071a31;border:0;border-radius:9px;padding:15px 22px;font-weight:bold;font-size:17px;cursor:pointer}button:disabled{opacity:.5;cursor:not-allowed}#player{margin:16px 0;max-width:100%}#status{margin:14px 0;color:#d5e6ff}.note{font-size:14px;color:#c4d2e8}</style></head><body><h1>Endon Music — Listening Extract 1</h1><div class="panel"><p><strong>Extract:</strong> 1:20–2:10 (50 seconds)</p><div id="player"></div><button id="play" disabled>Loading player…</button><p id="status" role="status">Connecting to YouTube…</p><p class="note">Press Play / Replay to hear the extract. Playback pauses automatically at 2:10. Requires internet access and YouTube embedding permission. Test on the computer used for the exam.</p></div><script>const START=80,END=130;let player,interval;const button=document.getElementById('play'),status=document.getElementById('status');function stopCheck(){if(interval){clearInterval(interval);interval=null}}function checkEnd(){if(player&&typeof player.getCurrentTime==='function'&&player.getCurrentTime()>=END){player.pauseVideo();stopCheck();status.textContent='Extract finished. Press Play / Replay to hear it again.'}}function onYouTubeIframeAPIReady(){player=new YT.Player('player',{width:'720',height:'405',videoId:'46C5IHC_uo8',playerVars:{start:START,playsinline:1,rel:0},events:{onReady:()=>{button.disabled=false;button.textContent='▶ Play / Replay extract';status.textContent='Ready to play.'},onStateChange:e=>{if(e.data===YT.PlayerState.PLAYING){stopCheck();interval=setInterval(checkEnd,100);status.textContent='Playing extract…'}else if(e.data===YT.PlayerState.PAUSED||e.data===YT.PlayerState.ENDED){stopCheck();if(e.data===YT.PlayerState.ENDED)status.textContent='Extract finished.'}},onError:e=>{stopCheck();status.textContent='YouTube playback error ('+e.data+'). This video may not allow embedded playback.'}}})}button.addEventListener('click',()=>{if(!player)return;stopCheck();player.seekTo(START,true);player.playVideo();status.textContent='Starting extract…'});const s=document.createElement('script');s.src='https://www.youtube.com/iframe_api';document.head.appendChild(s);setTimeout(()=>{if(button.disabled)status.textContent='The YouTube player has not loaded. Check internet access and whether this page is opened from an allowed web address.'},12000);</script></body></html>
